# CareIntel AI - Backend Environment Configuration

# Database Configuration (PostgreSQL in production, SQLite fallback for local development)
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway
# For local zero-config development:
# DATABASE_URL=sqlite:///./careintel.db

# API Configuration
PROJECT_NAME="CareIntel AI - Healthcare Intelligence"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
PORT=8000

# CORS Configuration
# Set FRONTEND_URL or CORS_ORIGINS to the deployed frontend domain in Railway
FRONTEND_URL=https://careintel-frontend.up.railway.app
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://careintel-frontend.up.railway.app"]

# AI Intelligence & Outreach Layer
# Supported AI providers: "gemini" | "openai" | "demo"
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
# For OpenAI:
# AI_PROVIDER=openai
# AI_API_KEY=your_openai_api_key_here
# AI_MODEL=gpt-4o-mini

# Web Scraper Configuration
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 (CareIntel Bot 1.0)"
